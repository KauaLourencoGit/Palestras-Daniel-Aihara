# ==============================================================================
# ARQUIVO DE EXEMPLO (.env.example) - NÃO CONTÉM CREDENCIAIS REAIS DE PRODUÇÃO
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# ==============================================================================

# Configurações Gerais
PROJECT_NAME="Site e Gestão de Palestras — Daniel Aihara"
ENVIRONMENT=development

# ATENÇÃO: Em produção, gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chave-secreta-desenvolvimento-unitri-grupo4-2026

# Banco de Dados (SQLite localmente; para Supabase/Railway use: postgresql://usuario:senha@host:5432/database)
DATABASE_URL=sqlite:///./data/palestras.db

# Credenciais Iniciais para carga inicial (Seed) da conta do Administrador
ADMIN_NAME="Daniel Takeo Aihara"
ADMIN_EMAIL=daniel.aihara@exemplo.com
# Em produção, altere esta senha antes de iniciar a primeira vez:
ADMIN_PASSWORD=admin123456

# Regras de Negócio Configuráveis
PALESTRAS_POR_DIA=1
DIAS_PRE_RESERVA=7
ANTECEDENCIA_MINIMA_DIAS=7
HORIZONTE_MAXIMO_MESES=18
LIMIT_REQUESTS_PER_IP_HOUR=5
TIMEZONE=America/Sao_Paulo
